# Copy to .env.local (never commit real values).
# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Needed for user provisioning (Admin → Users) and the notification worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# --- Application ---
APP_URL=http://localhost:3000
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Shows the DEMO ENVIRONMENT banner and demo account hints. Leave false in production.
DEMO_MODE=false
# Bearer token required by /api/jobs/notifications (scheduler → app). Generate a long random value.
CRON_SECRET=
# Used only by `npm run demo:users` when DEMO_MODE=true
DEMO_PASSWORD=
